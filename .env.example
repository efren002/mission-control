ENVIRONMENT=development
LOG_LEVEL=INFO
POSTGRES_DB=mission_control
POSTGRES_USER=mission_control
POSTGRES_PASSWORD=mission_control_dev
DATABASE_URL=postgresql+asyncpg://mission_control:mission_control_dev@postgres:5432/mission_control
REDIS_URL=redis://redis:6379/0
REPOSITORY_ROOT=/repositories
# May be absolute or relative to MISSION_CONTROL_HOST_ROOT.
REPOSITORY_HOST_ROOT=./repositories
REPOSITORY_UID=1000
REPOSITORY_GID=1000
ATTACHMENT_HOST_ROOT=./attachments
PROVIDER_GATEWAY_URL=http://provider-gateway:8100
PROVIDER_GATEWAY_TOKEN=replace-with-a-separate-long-random-token
LOCAL_ADMIN_TOKEN=replace-with-a-long-random-token
AUTO_ADMIN_LOGIN=true
API_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws/events
